.ct.catalog:
   -makedir $*
   CatComp Catalogs/lazymines.cd $< CATALOG $@

CFLAGS = math=ffp

OBJS = lazymines.o strings.o localize.o requesters.o counter.o layout.o \
       images.o field.o tooltypes.o highscores.o timer.o


all: LazyMines \
     Catalogs/Svenska/lazymines.catalog
     
LazyMines: $(OBJS)
   $(LD) FROM LIB:c.o $(OBJS) \
         TO LazyMines \
         LIB LIB:scmffp.lib LIB:sc.lib LIB:amiga.lib


Catalogs/Svenska/lazymines.catalog: Catalogs/svenska.ct

lazymines.o:  lazymines.c counter.h layout.h images.h game.h requesters.h \
              localize.h field.h tooltypes.h highscores.h timer.h
field.o:      field.c field.h layout.h
counter.o:    counter.c counter.h layout.h images.h
layout.o:     layout.c layout.h images.h game.h
images.o:     images.c images.h layout.h
highscores.o: highscores.c highscores.h layout_const.h
tooltypes.o:  tooltypes.c tooltypes.h
requesters.o: requesters.c requesters.h
localize.o:   localize.c localize.h
timer.o:      timer.c timer.h

localize.h: strings.o
   copy localize.h temp >NIL:
   delete localize.h >NIL:
   copy temp localize.h >NIL:
   delete temp >NIL:

strings.o: Catalogs/lazymines.cd
   CatComp $< CFILE strings.h OBJFILE $@


clean:
   -delete ALL \#?.o strings.h LazyMines Catalogs/~(\#?.\#?) lazymines.hiscore
